// use prisma-8

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  posts     Post[]
}

model Post {
  id        String @id @default(uuid())
  title     String
  content   String
  category  String
  
  userId    String?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}